cmake_minimum_required(VERSION 3.22)

set(root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
if("@WIN32@")
  foreach(app netgreeting greetingpost)
    execute_process(COMMAND "@WINDEPLOYQT_EXECUTABLE@" --no-translations
      --compiler-runtime --release "${root}/@CMAKE_INSTALL_BINDIR@/${app}.exe"
      COMMAND_ERROR_IS_FATAL ANY)
  endforeach()
elseif("@APPLE@")
  execute_process(COMMAND "@MACDEPLOYQT_EXECUTABLE@"
    "${root}/netgreeting.app" -always-overwrite -codesign=-
    "-executable=${root}/netgreeting.app/Contents/MacOS/greetingpost"
    COMMAND_ERROR_IS_FATAL ANY)
  # macdeployqt can leave an additional command-line executable's signature
  # stale after rewriting its load commands. Sign it before sealing the bundle.
  execute_process(COMMAND codesign --force --sign -
    "${root}/netgreeting.app/Contents/MacOS/greetingpost"
    COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND codesign --force --deep --sign - "${root}/netgreeting.app"
    COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND codesign --verify --deep --strict "${root}/netgreeting.app"
    COMMAND_ERROR_IS_FATAL ANY)
elseif("@NG_BUNDLE_RUNTIME@")
  execute_process(COMMAND "@Python3_EXECUTABLE@"
    "@CMAKE_SOURCE_DIR@/scripts/bundle-linux.py"
    "${root}" "@NG_QT_PLUGINS@" "@PATCHELF_EXECUTABLE@"
    COMMAND_ERROR_IS_FATAL ANY)
endif()
